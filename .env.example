# Copie este arquivo para ".env" e ajuste se necessário.
# Os valores abaixo já são os padrões usados pelo docker-compose e pelo backend.

# ---- PostgreSQL (docker-compose) ----
POSTGRES_DB=church_manager
POSTGRES_USER=church
POSTGRES_PASSWORD=church
POSTGRES_PORT=5432

# ---- pgAdmin (opcional: docker compose --profile tools up -d) ----
PGADMIN_EMAIL=admin@churchmanager.local
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050
