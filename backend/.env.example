# Variáveis de ambiente do backend (opcional).
# O backend já possui valores padrão em application.yml compatíveis com o docker-compose.
# Para sobrescrever, defina estas variáveis no seu terminal/IDE antes de rodar.

SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
DB_URL=jdbc:postgresql://localhost:5432/church_manager
DB_USERNAME=church
DB_PASSWORD=church
CORS_ALLOWED_ORIGINS=http://localhost:3000
